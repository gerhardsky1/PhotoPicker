# VHS-CRM – Schutzregeln (Hostinger / LiteSpeed)
# Der Passwortschutz wird über hPanel → Erweitert → „Passwortgeschützte Verzeichnisse“
# eingerichtet. Hostinger ergänzt dabei selbst die Zeilen AuthType/AuthUserFile/Require.

# Nur über HTTPS ausliefern (Passwort sonst im Klartext)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Nicht in Suchmaschinen aufnehmen
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Kein Verzeichnis-Listing, versteckte Dateien sperren
Options -Indexes
<FilesMatch "^\.ht">
  Require all denied
</FilesMatch>
