# Zugang nur mit Anmeldung (HTTP Basic Auth, Apache)
# AuthUserFile muss den ABSOLUTEN Serverpfad zur .htpasswd enthalten –
# idealerweise außerhalb des Web-Verzeichnisses. Pfad beim Hoster nachsehen.
AuthType Basic
AuthName "VHS-CRM – nur für berechtigte Personen"
AuthUserFile /PFAD/AUSSERHALB/DES/WEBROOTS/.htpasswd
Require valid-user

# Nur über HTTPS ausliefern (Passwort sonst im Klartext)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Nicht in Suchmaschinen aufnehmen
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# .htpasswd und andere versteckte Dateien nie ausliefern
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
Options -Indexes
